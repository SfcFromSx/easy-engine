{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "validation_status",
    "summary",
    "evidence",
    "severity",
    "next_action"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "next_action": {
      "type": "string"
    }
  }
}
