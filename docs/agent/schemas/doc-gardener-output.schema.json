{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "docs_updated",
    "stale_docs",
    "unresolved_drift"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "updated",
        "no_changes",
        "blocked"
      ]
    },
    "docs_updated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_drift": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
